# Axiom Scraper Environment Variables
# Copy this file to .env and fill in your values

# Database
DATABASE_PATH=data/axiom.duckdb

# Playwright
STORAGE_STATE_PATH=storage_state.json
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_TIMEOUT=30000

# Scraper Configuration
MAX_PULSE_ROWS=20
MAX_TRACKER_EVENTS=100
RATE_LIMIT_CONCURRENT=5
SCRAPE_DELAY_SECONDS=2

# Timezone (EET = Europe/Athens, Europe/Bucharest, etc.)
TIMEZONE=Europe/Athens

# Logging
LOG_LEVEL=INFO
LOG_DIR=logs

# Optional: Run metadata
GIT_SHA=

# Testing
ONLINE_TESTS=false

# FastAPI Service Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=false
API_WORKERS=1

# Redis Cache
API_REDIS_URL=redis://localhost:6379/0
API_CACHE_TTL_SHORT=300
API_CACHE_TTL_MEDIUM=600
API_CACHE_TTL_LONG=900

# Rate Limiting
API_RATE_LIMIT_ENABLED=true
API_RATE_LIMIT_DEFAULT=100/minute
API_RATE_LIMIT_SEARCH=20/minute

# Moralis API
API_MORALIS_API_KEY=
API_MORALIS_BASE_URL=https://deep-index.moralis.io/api/v2.2
API_MORALIS_TIMEOUT=10

# Supabase Authentication
API_SUPABASE_URL=
API_SUPABASE_JWKS_URL=
API_SUPABASE_JWT_SECRET=
API_JWT_ALGORITHM=RS256
API_JWT_AUDIENCE=authenticated

# CORS
API_CORS_ORIGINS=["*"]
API_CORS_CREDENTIALS=true

# API Logging
API_LOG_LEVEL=INFO
API_LOG_FORMAT=json

# Default Chain
API_DEFAULT_CHAIN=sol
